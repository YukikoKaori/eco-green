{
  "name": "eco-green",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:product": "npm run dev --workspace apps/product-web",
    "dev:management": "npm run dev --workspace apps/management-web",
    "dev:staff": "npm run dev --workspace apps/staff-web",
    "build:product": "npm run build --workspace apps/product-web",
    "build:management": "npm run build --workspace apps/management-web",
    "build:staff": "npm run build --workspace apps/staff-web",
    "preview:product": "npm run preview --workspace apps/product-web",
    "preview:management": "npm run preview --workspace apps/management-web",
    "preview:staff": "npm run preview --workspace apps/staff-web",
    "lint": "eslint \"apps/**/*.{ts,tsx}\"",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "gh-pages": "^6.1.1",
    "globals": "^16.4.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.43.0"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "recharts": "^3.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  }
}
